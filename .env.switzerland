# Switzerland Cluster Configuration
# Minimal configuration with multilingual support (FR, DE, IT)

# =============================================================================
# Base Configuration
# =============================================================================
NODE_ENV=production
API_TOKEN=switzerland-secure-api-token-replace-in-production

# =============================================================================
# Cluster Configuration
# =============================================================================
CLUSTER_NAME=switzerland
CLUSTER_FEATURES=
CLUSTER_LANGUAGES=fr,de,it

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_DB=mspr_switzerland
POSTGRES_USER=mspr_switzerland_user
POSTGRES_PASSWORD=switzerland-secure-password-replace-in-production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mspr_switzerland_user:switzerland-secure-password-replace-in-production@postgres:5432/mspr_switzerland

# =============================================================================
# Service Ports
# =============================================================================
FRONTEND_PORT=3000
BACKEND_PORT=3001
# =============================================================================
# Frontend Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api
CORS_ORIGIN=http://localhost:3000
