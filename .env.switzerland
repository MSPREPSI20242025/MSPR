# Switzerland Cluster Configuration
# Minimal configuration with multilingual support (FR, DE, IT)

# =============================================================================
# Base Configuration
# =============================================================================
NODE_ENV=production
API_TOKEN=switzerland-secure-api-token-replace-in-production

# =============================================================================
# Cluster Configuration
# =============================================================================
CLUSTER_NAME=switzerland
CLUSTER_FEATURES=
CLUSTER_LANGUAGES=fr,de,it

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_DB=mspr_switzerland
POSTGRES_USER=mspr_switzerland_user
POSTGRES_PASSWORD=switzerland-secure-password-replace-in-production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mspr_switzerland_user:switzerland-secure-password-replace-in-production@postgres:5432/mspr_switzerland

# =============================================================================
# Service Ports
# =============================================================================
FRONTEND_PORT=3000
BACKEND_PORT=3001
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# Frontend Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api
CORS_ORIGIN=http://localhost:3000
DEFAULT_LANGUAGE=fr

# =============================================================================
# ETL Configuration (Disabled)
# =============================================================================
ENABLE_ETL=false

# =============================================================================
# Security Configuration
# =============================================================================
JWT_SECRET=switzerland-jwt-secret-replace-in-production
SESSION_SECRET=switzerland-session-secret-replace-in-production
HTTPS_ENABLED=true
SECURE_COOKIES=true

# =============================================================================
# Multilingual Configuration
# =============================================================================
SUPPORTED_LANGUAGES=fr,de,it
FALLBACK_LANGUAGE=fr
AUTO_DETECT_LANGUAGE=true

# Language-specific configurations
LANGUAGE_FR_NAME=Français
LANGUAGE_DE_NAME=Deutsch
LANGUAGE_IT_NAME=Italiano

# =============================================================================
# Monitoring Configuration (Minimal)
# =============================================================================
ENABLE_MONITORING=false
LOG_LEVEL=warn
LOG_FORMAT=simple

# =============================================================================
# Backup Configuration
# =============================================================================
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# =============================================================================
# Disabled Features
# =============================================================================
ENABLE_API_TECHNICAL=false
ENABLE_DATAVIZ=false
ENABLE_ETL=false
ENABLE_REDIS=false

# =============================================================================
# Swiss Localization
# =============================================================================
TIMEZONE=Europe/Zurich
CURRENCY=CHF
DATE_FORMAT_FR=DD.MM.YYYY
DATE_FORMAT_DE=DD.MM.YYYY
DATE_FORMAT_IT=DD.MM.YYYY
NUMBER_FORMAT_FR=fr-CH
NUMBER_FORMAT_DE=de-CH
NUMBER_FORMAT_IT=it-CH