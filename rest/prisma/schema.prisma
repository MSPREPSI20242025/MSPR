generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CovidData {
  index           BigInt      @id @default(autoincrement())
  date            String
  country         String
  total_cases     BigInt
  new_cases       Float
  total_deaths    BigInt
  new_deaths      Float

  @@map("covid_data")
  @@index([country, date])
}

model MpoxData {
  index        BigInt      @id @default(autoincrement())
  date         String
  country      String
  total_cases  BigInt
  new_cases    BigInt
  total_deaths BigInt
  new_deaths   BigInt

  @@map("mpox_data")
  @@index([country, date])
}