# Configuration d'Environnement MSPR
# Copiez ce fichier vers .env et personnalisez pour votre environnement

# =============================================================================
# Configuration de Base
# =============================================================================
NODE_ENV=development
API_TOKEN=votre-token-api-securise-ici

# =============================================================================
# Configuration de la Base de Données
# =============================================================================
POSTGRES_DB=mspr
POSTGRES_USER=mspr_user
POSTGRES_PASSWORD=votre-mot-de-passe-securise-ici
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mspr_user:votre-mot-de-passe-securise-ici@postgres:5432/mspr

# =============================================================================
# Ports des Services
# =============================================================================
FRONTEND_PORT=3000
BACKEND_PORT=3001
REDIS_PORT=6379
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# Configuration des Clusters
# =============================================================================
# Options : us, france, switzerland
CLUSTER_NAME=us

# Liste des fonctionnalités à activer (séparées par des virgules)
# Disponibles : api_technical, dataviz, etl
CLUSTER_FEATURES=api_technical,dataviz,etl

# Liste des langues supportées (séparées par des virgules)
# Disponibles : en, fr, de, it
CLUSTER_LANGUAGES=en

# =============================================================================
# Configuration Frontend
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# Configuration ETL
# =============================================================================
# Planification cron pour les tâches ETL (par défaut : quotidien à 2h du matin)
ETL_SCHEDULE=0 2 * * *

# =============================================================================
# Configuration de Sécurité
# =============================================================================
# Secret JWT pour l'authentification
JWT_SECRET=votre-secret-jwt-ici

# Secret de session
SESSION_SECRET=votre-secret-session-ici

# =============================================================================
# Configuration RGPD (cluster France uniquement)
# =============================================================================
GDPR_COMPLIANCE=false
DATA_RETENTION_DAYS=90
GDPR_CONTACT_EMAIL=privacy@votre-organisation.com

# =============================================================================
# Configuration Performance (cluster US)
# =============================================================================
HIGH_VOLUME_MODE=false
PERFORMANCE_OPTIMIZATION=false

# =============================================================================
# Configuration Monitoring
# =============================================================================
# Activer les services de monitoring
ENABLE_MONITORING=false
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# =============================================================================
# Configuration des Logs
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# Configuration des Sauvegardes
# =============================================================================
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups